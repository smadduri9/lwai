# Copy this file to .env and fill in the keys you want to use.
# Deliberately NOT prefixed with VITE_ — keys stay on the Vite dev server only.
# The browser never sees these values.

# Local LLM (DEFAULT) — no key needed. The proxy auto-detects:
#   Ollama    http://127.0.0.1:11434  (ollama serve)
#   LM Studio http://127.0.0.1:1234   (start the local server)
# Override the base URL explicitly if needed (OpenAI chat-completions schema):
# LOCAL_LLM_BASE_URL=http://127.0.0.1:11434

# Claude (Anthropic) — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
